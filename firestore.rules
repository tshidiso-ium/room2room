rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activeAgent() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/accountStatus/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/accountStatus/$(request.auth.uid)).data.disabled != true
      );
    }

    function listingOwner() {
      return activeAgent() && resource.data.agentId == request.auth.uid;
    }

    function publicListingCounter() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        changed.hasOnly(['visitCount', 'lastVisitedAt']) &&
        changed.hasAll(['visitCount', 'lastVisitedAt']) &&
        request.resource.data.visitCount == resource.data.get('visitCount', 0) + 1 &&
        request.resource.data.lastVisitedAt == request.time
      ) || (
        changed.hasOnly(['contactClick', 'lastContactedAt']) &&
        changed.hasAll(['contactClick', 'lastContactedAt']) &&
        request.resource.data.contactClick == resource.data.get('contactClick', 0) + 1 &&
        request.resource.data.lastContactedAt == request.time
      );
    }

    match /apartments/{listingId} {
      allow read: if true;
      allow create: if activeAgent() &&
        request.resource.data.agentId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['isPromoted', 'promotedAt', 'promotedBy']);
      allow update: if publicListingCounter() || (
        listingOwner() &&
        request.resource.data.agentId == resource.data.agentId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPromoted', 'promotedAt', 'promotedBy',
          'visitCount', 'lastVisitedAt', 'contactClick', 'lastContactedAt'
        ])
      );
      allow delete: if listingOwner();
    }

    match /agents/{agentId} {
      allow read: if request.auth != null && request.auth.uid == agentId;
      allow create, update: if activeAgent() && request.auth.uid == agentId;
      allow delete: if false;
    }

    match /accountStatus/{uid} {
      allow read, write: if false;
    }

    match /stats/site {
      allow read, delete: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'pageViewCount', 'dailyViews', 'lastVisitedAt'
        ]) && request.resource.data.pageViewCount == 1 &&
        request.resource.data.lastVisitedAt == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pageViewCount', 'dailyViews', 'lastVisitedAt'
        ]) &&
        request.resource.data.pageViewCount == resource.data.get('pageViewCount', 0) + 1 &&
        request.resource.data.lastVisitedAt == request.time;
    }

    match /leads/{date}/items/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
